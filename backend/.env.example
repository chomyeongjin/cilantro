NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional: separate NAVER API HUB application with News Search enabled.
# When both are blank, the trend application's credentials are used.
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=

# Optional product discovery: Coupang Partners keys, NOT WING seller keys.
# Manual manufacturer registration does not need any Coupang credentials.
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=
COUPANG_PARTNERS_SUB_ID=

# Optional seller category lookup only. Not required for product discovery.
COUPANG_SELLER_ACCESS_KEY=
COUPANG_SELLER_SECRET_KEY=

# AI label extraction. Public HTTP GETs never trigger paid calls.
# GMS uses the SSAFY Responses endpoint and its own key, not an OpenAI key.
# Set gms/openai explicitly, or leave blank to prefer GMS when GMS_KEY exists.
AI_PROVIDER=
GMS_KEY=
GMS_MODEL=gpt-4.1

# Optional direct OpenAI access (unused when AI_PROVIDER=gms).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Exact manufacturer/regulator hosts approved for automated text collection.
# Leave blank when supplying label text in the source manifest.
PRODUCT_SOURCE_HOSTS=
